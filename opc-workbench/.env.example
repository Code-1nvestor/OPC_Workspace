# ============================================================
# OPC Workbench 环境变量配置
# ============================================================

# === LLM Provider 选择 ===
# 可选值: codebuddy | anthropic | openai
# codebuddy = 腾讯 CodeBuddy SDK（Claude 等模型）
# anthropic = 火山引擎 CodingPlan GLM-5.2（Anthropic API 格式）
# openai    = Agnes 或其他 OpenAI 兼容 API
LLM_PROVIDER=codebuddy

# === CodeBuddy Provider ===
# API Key 从 https://www.codebuddy.cn 获取
CODEBUDDY_API_KEY=
# 可选：Auth Token（二选一）
# CODEBUDDY_AUTH_TOKEN=
# 可选：环境设置
# CODEBUDDY_INTERNET_ENVIRONMENT=
# 可选：自定义 Base URL
# CODEBUDDY_BASE_URL=

# === Anthropic Provider（火山引擎 CodingPlan GLM-5.2）===
# API Key 从火山引擎控制台获取
ANTHROPIC_API_KEY=
# Base URL（火山 CodingPlan 使用此地址）
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v1
# 模型名称
ANTHROPIC_MODEL=glm-5.2

# === OpenAI Provider（Agnes 或其他 OpenAI 兼容）===
# API Key 从 https://platform.agnes-ai.com/ 获取
OPENAI_API_KEY=
# Base URL（Agnes 默认）
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
# 模型名称（agnes-2.0-flash 免费，512K 上下文）
OPENAI_MODEL=agnes-2.0-flash
